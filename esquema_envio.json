{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myko.mx/esquemas/pedido.json",
  "title": "Pedido MYKO con datos de envío",
  "type": "object",
  "additionalProperties": false,
  "required": ["id_carrito", "codigo_de_cliente", "acepta_aviso_privacidad", "envio"],
  "properties": {
    "id_carrito": { "type": "integer", "minimum": 1 },
    "codigo_de_cliente": { "type": "integer", "minimum": 1 },
    "acepta_aviso_privacidad": { "const": true },
    "envio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nombre_completo", "telefono", "correo", "calle", "numero_exterior",
        "colonia", "codigo_postal", "ciudad", "estado"
      ],
      "properties": {
        "nombre_completo": {
          "type": "string", "minLength": 3, "maxLength": 80,
          "pattern": "^[A-Za-zÁÉÍÓÚÜÑáéíóúüñ .'-]+$"
        },
        "telefono": { "type": "string", "pattern": "^[0-9]{10}$" },
        "correo": {
          "type": "string", "format": "email", "maxLength": 120,
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
        },
        "calle": { "type": "string", "minLength": 2, "maxLength": 100 },
        "numero_exterior": { "type": "string", "minLength": 1, "maxLength": 10 },
        "numero_interior": { "type": "string", "maxLength": 10 },
        "colonia": { "type": "string", "minLength": 2, "maxLength": 80 },
        "codigo_postal": { "type": "string", "pattern": "^[0-9]{5}$" },
        "ciudad": {
          "type": "string", "minLength": 2, "maxLength": 60,
          "pattern": "^[A-Za-zÁÉÍÓÚÜÑáéíóúüñ .'-]+$"
        },
        "estado": {
          "type": "string",
          "enum": [
            "Aguascalientes", "Baja California", "Baja California Sur", "Campeche",
            "Chiapas", "Chihuahua", "Ciudad de México", "Coahuila", "Colima",
            "Durango", "Estado de México", "Guanajuato", "Guerrero", "Hidalgo",
            "Jalisco", "Michoacán", "Morelos", "Nayarit", "Nuevo León", "Oaxaca",
            "Puebla", "Querétaro", "Quintana Roo", "San Luis Potosí", "Sinaloa",
            "Sonora", "Tabasco", "Tamaulipas", "Tlaxcala", "Veracruz", "Yucatán",
            "Zacatecas"
          ]
        },
        "referencias": { "type": "string", "maxLength": 200 }
      }
    }
  }
}
